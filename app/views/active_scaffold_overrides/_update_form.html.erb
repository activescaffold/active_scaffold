<%
  cancel_link = true if cancel_link.nil?
  headline ||=
    if @record.to_label.nil?
      active_scaffold_config.update.label
    else
      as_(:update_model, model: h(@record.to_label))
    end
%>
<%= render partial: 'base_form', locals: {xhr: xhr ||= nil,
                                          form_action: form_action ||= :update,
                                          method: method ||= :patch,
                                          cancel_link: cancel_link,
                                          headline: headline} %>
