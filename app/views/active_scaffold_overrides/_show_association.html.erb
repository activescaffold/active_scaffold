<%
  if local_assigns[:columns].is_a?(Array)
    columns = active_scaffold_config_for(column.association.klass).show.build_action_columns(columns)
  end
  associated = parent_record.send(column.name)
  associated = column.association.singular? ? [associated].compact : associated.to_a
  associated = associated.select { |record| record.send(tabbed_by) == tab_value } if local_assigns[:tabbed_by]
%>
<% if associated.present? %>
  <%= render "show_association_#{show_partial}", columns: columns, column: column, parent_record: parent_record,
                                                  associated: associated %>
<% end %>
