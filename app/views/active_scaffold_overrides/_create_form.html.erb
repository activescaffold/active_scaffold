<%
   form_action ||= :create
   cancel_link = true if cancel_link.nil?
   sti_label = @record.class.model_name.human(count: 1) if active_scaffold_config.add_sti_create_links?
   headline ||= active_scaffold_config.send(form_action).label(sti_label)
%>
<%= render partial: 'base_form', locals: {xhr: xhr ||= nil,
                                          form_action: form_action,
                                          method: method ||= :post,
                                          cancel_link: cancel_link,
                                          headline: headline} %>

