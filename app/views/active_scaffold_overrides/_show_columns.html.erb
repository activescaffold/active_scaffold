<%= as_element :show_columns_block do %>
  <% columns.each_column(for: record) do |column| %>
    <%= as_element :show_label_block, show_label(column) -%>
    <% if column.respond_to? :each_column -%>
      <%= as_element :show_columns_group, show_columns_group(column, record) %>
    <% else -%>
        <% css_class = "#{column.name}-view #{column.css_class unless column.css_class.is_a?(Proc)}" %>
        <%= as_element :show_value_block,
                       show_column_value(record, column, **local_assigns.slice(:tabbed_by, :tab_id, :tab_value)),
                       class: css_class.strip -%>
    <% end -%>
  <% end -%>
<% end %>
