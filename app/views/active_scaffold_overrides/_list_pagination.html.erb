<%= as_element :list_footer do %>
<% if active_scaffold_config.list.pagination != :infinite -%>
  <%= as_element :list_found, class: 'active-scaffold-found' do %>
    <%= as_element :list_found_count, @page.pager.count, class: 'active-scaffold-records' -%> <%= as_(:found, count: @page.pager.count) %>
  <% end %>
<% end -%>
<% if active_scaffold_config.list.pagination -%>
  <%= as_element :pagination_links, class: "active-scaffold-pagination #{'auto-paginate' if active_scaffold_config.list.auto_pagination}" do %>
    <%= render 'list_pagination_links', current_page: @page if @page.pager.infinite? || @page.pager.number_of_pages > 1 %>
  <% end -%>
<% end -%>
  <br /><!-- to clear this block -->
<% end -%>
