<%
  record ||= @record
  active_scaffold_config ||= self.active_scaffold_config
  partial = column.is_a?(Hash) ? 'render_field_traversing' : 'render_field_simple'
  locals = local_assigns.merge(column: column, record: record, active_scaffold_config: active_scaffold_config)
%>
<%= render partial: partial, locals: locals %>
